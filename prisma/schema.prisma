generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RESIGNED
  PROBATION
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  OVERTIME
  INCOMPLETE
}

enum AttendanceSource {
  EMPLOYEE
  HR
  SYSTEM
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum AllocationStatus {
  DRAFT
  PENDING
  APPROVED
  REFUSED
  EXPIRED
}

enum TimeOffRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  CONTRIBUTION
  NET
}

enum SalaryRuleComputationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  WARNING
  VALIDATED
  PAID
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PayrollWarningType {
  MISSING_BANK_DETAILS
  NO_ACTIVE_CONTRACT
  MULTIPLE_ACTIVE_CONTRACTS
  DUPLICATE_PAYSLIP
  MISSING_SALARY_STRUCTURE
  INVALID_SALARY_RULE
  INCOMPLETE_ATTENDANCE
}

enum PayrollWarningSeverity {
  INFO
  WARNING
  ERROR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  resetTokenHash String?
  resetTokenExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee?

  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager     Employee?     @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees   Employee[]
  contracts   Contract[]
  JobPosition JobPosition[]

  @@map("departments")
}

model JobPosition {
  id           String   @id @default(cuid())
  title        String
  code         String   @unique
  description  String?
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]
  contracts  Contract[]

  @@map("job_positions")
}

model WorkingSchedule {
  id           String   @id @default(cuid())
  name         String
  scheduleType String
  timezone     String   @default("UTC")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines     WorkingScheduleLine[]
  employees Employee[]
  contracts Contract[]

  @@map("working_schedules")
}

model WorkingScheduleLine {
  id                String    @id @default(cuid())
  workingScheduleId String
  dayOfWeek         DayOfWeek
  startTime         DateTime
  endTime           DateTime
  breakMinutes      Int       @default(0)
  sequence          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workingSchedule WorkingSchedule @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)

  @@unique([workingScheduleId, dayOfWeek])
  @@index([workingScheduleId])
  @@map("working_schedule_lines")
}

model Employee {
  id                String         @id @default(cuid())
  employeeCode      String         @unique
  firstName         String
  middleName        String?
  lastName          String
  workEmail         String         @unique
  personalEmail     String?
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?
  joiningDate       DateTime
  employmentType    EmploymentType @default(FULL_TIME)
  status            EmployeeStatus @default(ACTIVE)
  departmentId      String?
  jobPositionId     String?
  managerId         String?
  workingScheduleId String?
  userId            String?        @unique
  bankAccountNumber String?
  bankName          String?
  taxIdentifier     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobPosition         JobPosition?        @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  manager             Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates        Employee[]          @relation("EmployeeManager")
  workingSchedule     WorkingSchedule?    @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  contracts           Contract[]
  attendances         Attendance[]
  timeOffAllocations  TimeOffAllocation[]
  timeOffRequests     TimeOffRequest[]
  payslips            Payslip[]
  managedDepartments  Department[]        @relation("DepartmentManager")
  approvedAllocations TimeOffAllocation[] @relation("AllocationApprover")
  approvedRequests    TimeOffRequest[]    @relation("RequestApprover")
  createdPayruns      Payrun[]            @relation("PayrunCreator")
  resolvedWarnings    PayrollWarning[]    @relation("WarningResolver")
  editedAttendances   Attendance[]        @relation("AttendanceEditor")
  payrollWarnings     PayrollWarning[]    @relation("EmployeeWarnings")

  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@index([employeeCode])
  @@map("employees")
}

model Contract {
  id                String         @id @default(cuid())
  employeeId        String
  contractNumber    String         @unique
  startDate         DateTime
  endDate           DateTime?
  departmentId      String?
  jobPositionId     String?
  workingScheduleId String?
  salaryStructureId String?
  wage              Decimal        @db.Decimal(12, 2)
  currency          String         @default("USD")
  status            ContractStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobPosition     JobPosition?     @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  workingSchedule WorkingSchedule? @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  payslips        Payslip[]

  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([employeeId, startDate, endDate])
  @@map("contracts")
}

model Attendance {
  id               String           @id @default(cuid())
  employeeId       String
  attendanceDate   DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  workedMinutes    Int?
  overtimeMinutes  Int              @default(0)
  status           AttendanceStatus @default(PRESENT)
  source           AttendanceSource @default(SYSTEM)
  isManuallyEdited Boolean          @default(false)
  editedByUserId   String?
  correctionReason String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  editedBy Employee? @relation("AttendanceEditor", fields: [editedByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
  @@index([employeeId, attendanceDate])
  @@map("attendances")
}

model TimeOffType {
  id                 String      @id @default(cuid())
  name               String
  code               String      @unique
  unit               TimeOffUnit @default(DAYS)
  requiresAllocation Boolean     @default(true)
  requiresApproval   Boolean     @default(true)
  isPaid             Boolean     @default(true)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]

  @@map("time_off_types")
}

model TimeOffAllocation {
  id              String           @id @default(cuid())
  employeeId      String
  timeOffTypeId   String
  allocatedAmount Decimal          @db.Decimal(10, 2)
  usedAmount      Decimal          @default(0) @db.Decimal(10, 2)
  validFrom       DateTime         @db.Date
  validUntil      DateTime         @db.Date
  status          AllocationStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType TimeOffType      @relation(fields: [timeOffTypeId], references: [id], onDelete: Cascade)
  approvedBy  Employee?        @relation("AllocationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  requests    TimeOffRequest[]

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([status])
  @@index([validFrom, validUntil])
  @@map("time_off_allocations")
}

model TimeOffRequest {
  id              String               @id @default(cuid())
  employeeId      String
  timeOffTypeId   String
  allocationId    String?
  startDate       DateTime             @db.Date
  endDate         DateTime             @db.Date
  requestedAmount Decimal              @db.Decimal(10, 2)
  reason          String?
  status          TimeOffRequestStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  refusalReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType TimeOffType        @relation(fields: [timeOffTypeId], references: [id], onDelete: Cascade)
  allocation  TimeOffAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  approvedBy  Employee?          @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([employeeId, status])
  @@map("time_off_requests")
}

model SalaryStructure {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structureRules SalaryStructureRule[]
  contracts      Contract[]
  payruns        Payrun[]
  payslips       Payslip[]

  @@map("salary_structures")
}

model SalaryRule {
  id              String                    @id @default(cuid())
  name            String
  code            String                    @unique
  category        SalaryRuleCategory
  sequence        Int                       @default(0)
  computationType SalaryRuleComputationType @default(FIXED)
  fixedAmount     Decimal?                  @db.Decimal(12, 2)
  percentage      Decimal?                  @db.Decimal(5, 2)
  percentageBase  String?
  formula         String?
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  structureRules SalaryStructureRule[]
  payslipLines   PayslipLine[]

  @@index([category])
  @@index([sequence])
  @@index([code])
  @@map("salary_rules")
}

model SalaryStructureRule {
  id                String   @id @default(cuid())
  salaryStructureId String
  salaryRuleId      String
  sequence          Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryRule      SalaryRule      @relation(fields: [salaryRuleId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, salaryRuleId])
  @@index([salaryStructureId])
  @@index([salaryRuleId])
  @@map("salary_structure_rules")
}

model Payrun {
  id                String       @id @default(cuid())
  name              String
  salaryStructureId String
  periodStart       DateTime     @db.Date
  periodEnd         DateTime     @db.Date
  status            PayrunStatus @default(DRAFT)
  createdById       String
  computedAt        DateTime?
  validatedAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  salaryStructure SalaryStructure  @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  createdBy       Employee         @relation("PayrunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payslips        Payslip[]
  warnings        PayrollWarning[]

  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
  @@index([salaryStructureId])
  @@index([periodStart, periodEnd])
  @@map("payruns")
}

model Payslip {
  id                 String        @id @default(cuid())
  payrunId           String
  employeeId         String
  contractId         String
  salaryStructureId  String
  periodStart        DateTime      @db.Date
  periodEnd          DateTime      @db.Date
  workedDays         Decimal       @default(0) @db.Decimal(5, 2)
  workedHours        Decimal       @default(0) @db.Decimal(5, 2)
  basicAmount        Decimal       @default(0) @db.Decimal(12, 2)
  grossAmount        Decimal       @default(0) @db.Decimal(12, 2)
  deductionAmount    Decimal       @default(0) @db.Decimal(12, 2)
  contributionAmount Decimal       @default(0) @db.Decimal(12, 2)
  netAmount          Decimal       @default(0) @db.Decimal(12, 2)
  currency           String        @default("USD")
  status             PayslipStatus @default(DRAFT)
  warningCount       Int           @default(0)
  computedAt         DateTime?
  validatedAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payrun          Payrun           @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract        Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  salaryStructure SalaryStructure  @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  lines           PayslipLine[]
  warnings        PayrollWarning[]

  @@unique([payrunId, employeeId])
  @@index([employeeId])
  @@index([payrunId])
  @@index([status])
  @@index([contractId])
  @@map("payslips")
}

model PayslipLine {
  id           String             @id @default(cuid())
  payslipId    String
  salaryRuleId String
  ruleCode     String
  ruleName     String
  category     SalaryRuleCategory
  sequence     Int
  quantity     Decimal            @default(1) @db.Decimal(10, 2)
  rate         Decimal            @default(0) @db.Decimal(12, 2)
  baseAmount   Decimal            @default(0) @db.Decimal(12, 2)
  amount       Decimal            @default(0) @db.Decimal(12, 2)
  createdAt    DateTime           @default(now())

  payslip    Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRule SalaryRule @relation(fields: [salaryRuleId], references: [id], onDelete: Restrict)

  @@index([payslipId])
  @@index([salaryRuleId])
  @@map("payslip_lines")
}

model PayrollWarning {
  id           String                 @id @default(cuid())
  payrunId     String
  payslipId    String?
  employeeId   String
  type         PayrollWarningType
  severity     PayrollWarningSeverity @default(WARNING)
  message      String
  resolved     Boolean                @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime               @default(now())

  payrun     Payrun    @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  payslip    Payslip?  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("EmployeeWarnings", fields: [employeeId], references: [id], onDelete: Restrict)
  resolvedBy Employee? @relation("WarningResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([payrunId])
  @@index([payslipId])
  @@index([employeeId])
  @@index([type])
  @@index([resolved])
  @@map("payroll_warnings")
}
