# Database Provider Toggle
# Options: 'postgresql' (Prisma + NeonDB) | 'mongodb' (Mongoose + MongoDB Atlas)
DB_PROVIDER=postgresql

# PostgreSQL / NeonDB (Primary - used when DB_PROVIDER=postgresql)
# Pooled connection (used by application)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
# Direct connection (used for migrations)
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# MongoDB Atlas (Secondary - used when DB_PROVIDER=mongodb)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGODB_DB_NAME=peoplepay360_logs

# Application
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Frontend
REACT_APP_API_URL=http://localhost:4000/api